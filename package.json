{
  "name": "gostrata-setup",
  "productName": "gostrata Setup",
  "version": "1.0.0",
  "description": "Graphical setup for gostrata: installs gostrata and the Go compiler",
  "main": "src/main.cjs",
  "author": {
    "name": "ebinskryfon",
    "email": "skryfon@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:core": "node test/core.test.cjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.gostrata.setup",
    "productName": "gostrata Setup",
    "files": [
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "gostrata-setup-linux.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "gostrata-setup-windows.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "gostrata-setup-macos.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
